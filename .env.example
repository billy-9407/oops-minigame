# 최초 배포는 관리자만 테스트하며 실제 코인은 지급하지 않습니다.
# 공개 요청을 받은 뒤 Vercel GAME_ACCESS=public / 봇 MINIGAME_ACCESS=public으로 변경하세요.
GAME_ACCESS=admin
MINIGAME_ACCESS=admin
# 디스호스트와 Vercel에 동일한 32자 이상의 키를 설정하세요.
GAME_SECRET_KEY=
# 선택: Vercel Marketplace > Upstash Redis 연결. 공용 TOP 10을 저장합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 디스호스트 봇 설정
MINIGAME_URL=https://oops-minigame.vercel.app/
